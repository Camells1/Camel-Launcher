# Custom "page not found" (also used by the hidden admin page)
ErrorDocument 404 /404.html
Options -Indexes

# Clean addresses: yoursite.com/live instead of yoursite.com/live.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # old page names keep working (and go to the new name)
  RewriteRule ^stats(\.html)?$ /live [R=301,L]
  RewriteRule ^smp(\.html)?$ /server [R=301,L]
  RewriteRule ^leaderboard(\.html)?$ /donators [R=301,L]
  RewriteRule ^fun(\.html)?$ /games [R=301,L]
  RewriteRule ^pedia(\.html)?$ /yokii-pedia [R=301,L]
  RewriteRule ^index(\.html)?$ / [R=301,L]
  # anything typed with .html: drop the .html
  RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L,NE]
  # a page with a trailing slash: drop the slash
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]
  # yoursite.com/live -> serve live.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)$ $1.html [L]
</IfModule>

# Pages are always checked for a newer version; images/scripts use ?v= numbers
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Config and helper files are never served directly
<FilesMatch "^(config|lib)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "\.(txt|md|zip)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<FilesMatch "\.tpl\.js$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
