{
  "name": "camel-launcher",
  "version": "1.0.0",
  "description": "Camel Launcher - a custom Minecraft launcher with a built-in Modrinth mod browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "@xmcl/installer": "^5.4.0",
    "msmc": "^5.0.5"
  },
  "overrides": {
    "undici": "6.28.0"
  },
  "build": {
    "appId": "com.example.camellauncher",
    "productName": "Camel Launcher",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
