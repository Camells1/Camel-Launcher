{
  "name": "camel-launcher",
  "version": "1.2.2",
  "description": "Camel Launcher - a custom Minecraft launcher with a built-in Modrinth mod browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "@xmcl/installer": "^5.4.0",
    "electron-updater": "^6.8.9",
    "yauzl": "2.10.0",
    "msmc": "^5.0.5"
  },
  "overrides": {
    "undici": "6.28.0"
  },
  "build": {
    "appId": "com.example.camellauncher",
    "productName": "Camel Launcher",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "build/icons/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeader": "build/installer/header.bmp",
      "installerSidebar": "build/installer/sidebar.bmp",
      "uninstallerSidebar": "build/installer/sidebar.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Camells1",
        "repo": "Camel-Launcher"
      }
    ]
  }
}
